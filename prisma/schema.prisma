generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Imovel {
  id          Int      @id @default(autoincrement())
  titulo      String
  tipo        String
  cidade      String
  estado      String   @default("PR")
  descricao   String?
  preco       Decimal
  quartos     Int?
  banheiros   Int?
  area        Float?
  imagemUrl   String?
  disponivel  Boolean  @default(true)
  destaque    Boolean  @default(false)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fotos       FotoImovel[]
}

model FotoImovel {
  id        Int      @id @default(autoincrement())
  url       String
  ordem     Int      @default(0)
  imovelId  Int
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([imovelId, ordem])
}

model Interessado {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String
  email     String?
  mensagem  String?
  imovelId  Int?
  createdAt DateTime @default(now())
}
